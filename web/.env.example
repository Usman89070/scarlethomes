# Scarlet Homes - settings for the Node.js app (web/server.js).
# On Hostinger: Node.js app -> Settings -> Environment variables (same names), or copy this
# file to .env next to package.json. Never commit the real .env.

# --- MySQL (hPanel -> Databases -> MySQL Databases; host as shown there, often localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_scarlet
DB_USER=u000000000_scarlet
DB_PASS=change-me

# --- site
SITE_URL=https://scarlethomes.com.au
# long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string
TIMEZONE=Australia/Sydney

# --- enquiry emails (create the mailbox in hPanel -> Emails)
MAIL_TO=info@scarlethomes.com.au
MAIL_FROM=website@scarlethomes.com.au
MAIL_FROM_NAME=Scarlet Homes Website
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=website@scarlethomes.com.au
SMTP_PASS=change-me

# --- portal file uploads: a folder OUTSIDE the app folder, so redeploys never delete files.
# Copy the old site's storage/app/public/* in here to keep existing plans/photos.
UPLOADS_DIR=/home/u000000000/scarlet-uploads
MAX_UPLOAD_MB=20

# --- first admin (only for a fresh database; ignored once an admin exists - then delete these)
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_NAME=
SETUP_ADMIN_PASSWORD=

# --- advanced (defaults are right for Hostinger)
TRUST_PROXY=1
INSECURE_COOKIES=0
ENQUIRY_MAX_PER_HOUR=5
